function LineageData.byRarity(rarityId: string)
	local list = {}
	for id, l in pairs(LineageData.Lineages) do
		if l.rarity == rarityId then table.insert(list, id) end
	end
	table.sort(list)
	return list
end

function LineageData.rarityIndex(rarityId: string): number
	for i, r in ipairs(LineageData.Rarities) do
		if r.id == rarityId then return i end
	end
	return 0
end

return LineageData
