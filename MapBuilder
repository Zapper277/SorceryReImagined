
--!nonstrict
--[[
	MapBuilder  (ServerScriptService/Services/MapBuilder)
	HEXBOUND - builds a playable greybox (blockout) map for each mission theme, plus the hub.

	These are layout blockouts made of Parts: the right scale, paths, cover, sightlines and
	objective placements. They're meant to be played and tuned now, then replaced or dressed by an
	environment artist later. Each theme uses a seed so prop placement varies between runs while
	keeping the same overall layout.

	MapBuilder:Build(themeId, origin: Vector3, seed?) -> layout
	layout = {
		folder: Folder,
		playerSpawns: { CFrame },
		curseSpawns: { Vector3 },
		nests: { Vector3 }?,          -- PurgeNest
		escortPath: { Vector3 }?,     -- Escort (first = start, last = extraction)
		ward: Vector3?,               -- Warding
		bossSpawn: Vector3?,          -- Calamity
		bounds: { center: Vector3, size: Vector3 }, -- MissionService uses this to bring players back if they fall out of the map
	}
	MapBuilder:BuildHub(origin) -> { folder, spawn: CFrame, missionBoard: BasePart, rollShrine: BasePart }
]]

local MapBuilder = {}

----------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.Concrete
	p.Color = props.Color or Color3.fromRGB(90, 90, 95)
	p.Size = props.Size
	p.CFrame = props.CFrame
	if props.Shape then p.Shape = props.Shape end
	if props.Transparency then p.Transparency = props.Transparency end
	if props.CanCollide == false then p.CanCollide = false end
	p.Name = props.Name or "Block"
	p.Parent = parent
	return p
end

local function light(parentPart, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range or 24
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = parentPart
	return l
end

local function lamp(parent, pos, color)
	local p = part(parent, { Name = "Lamp", Size = Vector3.new(1.5, 0.6, 1.5), CFrame = CFrame.new(pos),
		Material = Enum.Material.Neon, Color = color, CanCollide = false })
	light(p, color, 28, 1.6)
	return p
end

-- A box room with walls (no ceiling unless one is requested). doors = list of { side = "N|S|E|W", width }
local function room(parent, center: Vector3, size: Vector3, opts)
	opts = opts or {}
	local wallT = 2
	local mat = opts.wallMaterial or Enum.Material.Concrete
	local col = opts.wallColor or Color3.fromRGB(85, 85, 90)
	if not opts.noFloor then
		part(parent, { Name = "Floor", Size = Vector3.new(size.X, 1, size.Z), CFrame = CFrame.new(center - Vector3.new(0, 0.5, 0)),
			Material = opts.floorMaterial or Enum.Material.Slate, Color = opts.floorColor or Color3.fromRGB(60, 60, 65) })
	end

	local doors = {}
	for _, d in ipairs(opts.doors or {}) do doors[d.side] = d.width end

	local function wall(side, length, cf)
		local doorW = doors[side]
		if not doorW then
			part(parent, { Name = "Wall", Size = Vector3.new(length, size.Y, wallT), CFrame = cf * CFrame.new(0, size.Y / 2, 0),
				Material = mat, Color = col })
			return
		end
		local seg = (length - doorW) / 2
		for _, sign in ipairs({ -1, 1 }) do
			part(parent, { Name = "Wall", Size = Vector3.new(seg, size.Y, wallT),
				CFrame = cf * CFrame.new(sign * (doorW / 2 + seg / 2), size.Y / 2, 0), Material = mat, Color = col })
		end
		part(parent, { Name = "Lintel", Size = Vector3.new(doorW, size.Y * 0.3, wallT),
			CFrame = cf * CFrame.new(0, size.Y * 0.85, 0), Material = mat, Color = col })
	end
	wall("N", size.X, CFrame.new(center + Vector3.new(0, 0, -size.Z / 2)))
	wall("S", size.X, CFrame.new(center + Vector3.new(0, 0, size.Z / 2)))
	wall("E", size.Z, CFrame.new(center + Vector3.new(size.X / 2, 0, 0)) * CFrame.Angles(0, math.rad(90), 0))
	wall("W", size.Z, CFrame.new(center + Vector3.new(-size.X / 2, 0, 0)) * CFrame.Angles(0, math.rad(90), 0))
	if opts.ceiling then
		part(parent, { Name = "Ceiling", Size = Vector3.new(size.X, 1, size.Z), CFrame = CFrame.new(center + Vector3.new(0, size.Y + 0.5, 0)),
			Material = mat, Color = col })
	end
end

-- Scatter cover blocks inside a rectangle, keeping clear of the given points
local function scatterCover(parent, rng, center, area: Vector2, count, keepClear, style)
	local placed = 0
	local tries = 0
	while placed < count and tries < count * 10 do
		tries += 1
		local x = center.X + (rng:NextNumber() - 0.5) * area.X
		local z = center.Z + (rng:NextNumber() - 0.5) * area.Y
		local pos = Vector3.new(x, center.Y, z)
		local ok = true
		for _, k in ipairs(keepClear or {}) do
			if (Vector3.new(k.X, center.Y, k.Z) - pos).Magnitude < 14 then ok = false break end
		end
		if ok then
			local s = style or {}
			local w = rng:NextNumber(s.minW or 4, s.maxW or 10)
			local h = rng:NextNumber(s.minH or 3, s.maxH or 6)
			local d = rng:NextNumber(s.minW or 4, s.maxW or 10)
			part(parent, { Name = s.name or "Cover", Size = Vector3.new(w, h, d),
				CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
				Material = s.material or Enum.Material.Concrete, Color = s.color or Color3.fromRGB(100, 100, 105) })
			placed += 1
		end
	end
end

local function killFloor(parent, center, size)
	-- Invisible part below the map; MissionService teleports anything that touches it back to a spawn
	return part(parent, { Name = "KillFloor", Size = Vector3.new(size.X + 200, 2, size.Z + 200),
		CFrame = CFrame.new(center - Vector3.new(0, 60, 0)), Transparency = 1, CanCollide = false })
end

